<Window x:Class="WpfApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">


    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
        
            <ColumnDefinition Width="*"/>
         
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
         
            <RowDefinition Height="*"/>
        
        </Grid.RowDefinitions>

     
        <TextBlock Text="Название программы" 
                   Grid.Row="0" Grid.Column="0" 
                   FontSize="18" FontWeight="Bold" 
                   Margin="15" 
                   VerticalAlignment="Center"/>

        <StackPanel Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" 
                    VerticalAlignment="Center" 
                    Margin="15">

            <Button x:Name="Btn1" Content="кнопка 1" 
                    Height="40" Margin="0,0,0,10" 
                    Click="Btn1_Click"/>

            <Button x:Name="Btn2" Content="кнопка 2" 
                    Height="40" Margin="0,0,0,20" 
                    Click="Btn2_Click"/>

          
            <TextBlock x:Name="MessageText" 
                       Text="Нажмите на кнопку..." 
                       TextWrapping="Wrap" 
                       FontSize="14" 
                       FontWeight="Bold"
                       Foreground="DarkBlue"
                       TextAlignment="Center"/>
        </StackPanel>

        <Image Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
               Source="C:\Users\243450\source\repos\WpfApp2\WpfApp2\cat\b428eba9ebcab1e24ef25d9523b2a433.jpg"
               Stretch="Uniform" 
               HorizontalAlignment="Center" 
               VerticalAlignment="Center"
               Margin="20"/>
    </Grid>
</Window>